<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:background="@color/panel_background"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="服务器设置"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/server_ip_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:hint="服务器 IPv4，例如 192.168.1.100"
        android:inputType="textVisiblePassword"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/panel_muted"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/server_port_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:hint="端口，例如 8080"
        android:inputType="number"
        android:maxLength="5"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/panel_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/server_settings_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/error"
        android:textSize="14sp" />
</LinearLayout>
